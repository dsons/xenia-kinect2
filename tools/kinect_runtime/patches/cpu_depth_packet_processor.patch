+// Threads for the depth decode (XK2_DEPTH_THREADS overrides). Single-threaded
+// the decode takes about 100 ms a frame and two of every three frames are
+// dropped; rows are handed out dynamically so that slower cores do not hold
+// a frame back.
+static int depth_threads()
+{
+  static int n = 0;
+  if(n == 0)
+  {
+    const char *e = getenv("XK2_DEPTH_THREADS");
+    n = e ? atoi(e) : 4;
+    if(n < 1) n = 1;
+  }
+  return n;
+}
