--- a/src/libfreenect2.cpp
+++ b/src/libfreenect2.cpp
@@ -1008,7 +1008,16 @@
     ir_transfer_pool_.cancel();
   }
 
-  if (usb_control_.setIrInterfaceState(UsbControl::Disabled) != UsbControl::Success) return false;
+  // With Microsoft's WinUSB driver this alternate-setting change can fail
